<% var minutes = (typeof expiryMinutes !== 'undefined' && expiryMinutes) ?
expiryMinutes : 2; %> <% var brand = (typeof appName !== 'undefined' && appName)
? appName : 'Spark'; %> <% var tagline = (typeof tagline !== 'undefined' &&
tagline) ? tagline : "Shop smarter, shop faster"; %> <% var logoUrl = (typeof
logoUrl !== 'undefined' && logoUrl) ? logoUrl :
'https://res.cloudinary.com/dbnnwoges/image/upload/v1792242318/IMG_6643_lu29zy.png'; %> <% var dateStr = (typeof dateStr
!== 'undefined' && dateStr) ? dateStr : new Date().toLocaleDateString('en-US',
{ day: 'numeric', month: 'long', year: 'numeric' }); %> <% var siteUrl =
(typeof siteUrl !== 'undefined' && siteUrl) ? siteUrl : 'spark.com'; %> <% var
phone = (typeof phone !== 'undefined' && phone) ? phone : '+88 01XXX-XXXXXX';
%> <% var address = (typeof address !== 'undefined' && address) ? address :
'Sylhet, Bangladesh'; %> <% var facebookUrl = (typeof facebookUrl !==
'undefined' && facebookUrl) ? facebookUrl : 'https://www.facebook.com/spark'; %> <% var instagramUrl =
(typeof instagramUrl !== 'undefined' && instagramUrl) ? instagramUrl : 'https://www.instagram.com/spark';
%> <% var tiktokUrl = (typeof tiktokUrl !== 'undefined' && tiktokUrl) ?
tiktokUrl : 'https://www.tiktok.com/spark'; %>
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Your verification code</title>
        <style>
            body,
            table,
            td {
                -ms-text-size-adjust: 100%;
                -webkit-text-size-adjust: 100%;
            }
            body {
                margin: 0;
                padding: 0;
                width: 100% !important;
                background-color: #f5f5f7;
            }
            .otp-code {
                letter-spacing: 6px;
            }
            .hl {
                background-color: #fdecb2;
                padding: 2px 4px;
                border-radius: 3px;
            }
            @media only screen and (max-width: 600px) {
                .container {
                    width: 100% !important;
                }
                .px {
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }
                .otp-code {
                    font-size: 30px !important;
                    letter-spacing: 4px !important;
                }
                .brand-name {
                    font-size: 22px !important;
                }
            }
        </style>
    </head>
    <body style="margin: 0; padding: 0; background-color: #f5f5f7">
        <div
            style="
                display: none;
                max-height: 0;
                overflow: hidden;
                mso-hide: all;
            "
        >
            Your one-time password expires in <%= minutes %>
            minutes&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;
        </div>

        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
        >
            <tr>
                <td align="center" style="padding: 48px 16px 24px">
                    <table
                        role="presentation"
                        class="container"
                        width="620"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="width: 620px; max-width: 620px"
                    >
                        <!-- CARD -->
                        <tr>
                            <td
                                class="px"
                                style="
                                    background-color: #ffffff;
                                    border-radius: 14px;
                                    padding: 40px 48px 44px;
                                    box-shadow: 0 1px 3px rgba(16, 24, 40, 0.06);
                                "
                            >
                                <!-- HEADER -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                >
                                    <tr>
                                        <td valign="middle" width="56">
                                            <img
                                                src="<%= logoUrl %>"
                                                alt="<%= brand %>"
                                                width="56"
                                                height="56"
                                                style="
                                                    display: block;
                                                    width: 56px;
                                                    height: 56px;
                                                    border-radius: 12px;
                                                    background-color: #0b0b0b;
                                                "
                                            />
                                        </td>
                                        <td
                                            valign="middle"
                                            style="padding-left: 14px"
                                        >
                                            <span
                                                class="brand-name"
                                                style="
                                                    font-family:
                                                        -apple-system,
                                                        BlinkMacSystemFont,
                                                        &quot;Segoe UI&quot;,
                                                        Roboto, Helvetica,
                                                        Arial, sans-serif;
                                                    font-size: 26px;
                                                    font-weight: 800;
                                                    color: #15203d;
                                                    display: block;
                                                "
                                                ><%= brand %></span
                                            >
                                            <span
                                                style="
                                                    font-family:
                                                        -apple-system,
                                                        BlinkMacSystemFont,
                                                        &quot;Segoe UI&quot;,
                                                        Roboto, Helvetica,
                                                        Arial, sans-serif;
                                                    font-size: 13px;
                                                    color: #6b7280;
                                                "
                                                ><%= tagline %></span
                                            >
                                        </td>
                                        <td valign="middle" align="right">
                                            <span
                                                style="
                                                    font-family:
                                                        -apple-system,
                                                        BlinkMacSystemFont,
                                                        &quot;Segoe UI&quot;,
                                                        Roboto, Helvetica,
                                                        Arial, sans-serif;
                                                    font-size: 14px;
                                                    color: #6b7280;
                                                    white-space: nowrap;
                                                "
                                                ><%= dateStr %></span
                                            >
                                        </td>
                                    </tr>
                                </table>

                                <!-- DIVIDER -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                >
                                    <tr>
                                        <td style="padding: 24px 0 28px">
                                            <hr
                                                style="
                                                    border: none;
                                                    border-top: 1px solid
                                                        #ececec;
                                                    margin: 0;
                                                "
                                            />
                                        </td>
                                    </tr>
                                </table>

                                <!-- HEADLINE -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                >
                                    <tr>
                                        <td
                                            align="center"
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 26px;
                                                font-weight: 800;
                                                color: #15203d;
                                                padding-bottom: 24px;
                                            "
                                        >
                                           <%= subject %>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 16px;
                                                line-height: 26px;
                                                color: #374151;
                                                padding-bottom: 6px;
                                            "
                                        >
                                            Dear <b><%= name %></b>,
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 16px;
                                                line-height: 26px;
                                                color: #374151;
                                                padding-bottom: 20px;
                                            "
                                        >
                                            Here is your
                                            <span class="hl"
                                                >One-Time Password</span
                                            >
                                            to securely log in to your
                                            <%= brand %> account:
                                        </td>
                                    </tr>

                                    <!-- OTP CODE -->
                                    <tr>
                                        <td align="center" style="padding: 8px 0 8px">
                                            <span
                                                class="otp-code"
                                                style="
                                                    font-family:
                                                        &quot;SFMono-Regular&quot;,
                                                        Consolas,
                                                        &quot;Liberation Mono&quot;,
                                                        Menlo, Courier,
                                                        monospace;
                                                    font-size: 42px;
                                                    font-weight: 800;
                                                    color: #15203d;
                                                "
                                                ><%= otp %></span
                                            >
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            align="center"
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 14px;
                                                color: #6b7280;
                                                padding: 10px 0 26px;
                                            "
                                        >
                                            Note: This
                                            <span class="hl">OTP</span> is
                                            valid for <%= minutes %> minutes.
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 15px;
                                                line-height: 25px;
                                                color: #374151;
                                                padding-bottom: 24px;
                                            "
                                        >
                                            If you did not request this
                                            <span class="hl">OTP</span>, please
                                            disregard this email or contact
                                            our support team. Thank you for
                                            shopping with <%= brand %>!
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 15px;
                                                color: #15203d;
                                                font-weight: 700;
                                            "
                                        >
                                            Best Regards
                                        </td>
                                    </tr>
                                    <tr>
                                        <td
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 15px;
                                                color: #6b7280;
                                            "
                                        >
                                            Team <%= brand %>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                       <!-- SOCIAL ICONS -->
                        <tr>
                            <td align="center" style="padding: 28px 16px 0">
                                <table
                                    role="presentation"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                >
                                    <tr>
                                        <td style="padding: 0 10px">
                                            <a href="<%= facebookUrl %>" style="text-decoration: none">
                                                <img
                                                    src="https://res.cloudinary.com/dbnnwoges/image/upload/v1792262511/facebook_dx4ieg.svg"
                                                    width="34"
                                                    height="34"
                                                    alt="Facebook"
                                                    style="display: block; width: 34px; height: 34px"
                                                />
                                            </a>
                                        </td>
                                        <td style="padding: 0 10px">
                                            <a href="<%= instagramUrl %>" style="text-decoration: none">
                                                <img
                                                    src="https://res.cloudinary.com/dbnnwoges/image/upload/v1792262511/instagram_z68z55.svg"
                                                    width="34"
                                                    height="34"
                                                    alt="Instagram"
                                                    style="display: block; width: 34px; height: 34px"
                                                />
                                            </a>
                                        </td>
                                        <td style="padding: 0 10px">
                                            <a href="<%= tiktokUrl %>" style="text-decoration: none">
                                                <img
                                                    src="https://res.cloudinary.com/dbnnwoges/image/upload/v1792262511/tiktok_tkap8r.svg"
                                                    width="34"
                                                    height="34"
                                                    alt="TikTok"
                                                    style="display: block; width: 34px; height: 34px"
                                                />
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- FOOTER -->
                        <tr>
                            <td align="center" style="padding: 20px 16px 0">
                                <span
                                    style="
                                        font-family:
                                            -apple-system, BlinkMacSystemFont,
                                            &quot;Segoe UI&quot;, Roboto,
                                            Helvetica, Arial, sans-serif;
                                        font-size: 13px;
                                        color: #8893b5;
                                    "
                                >
                                    Site: <%= siteUrl %> | Phone: <%= phone %>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding: 6px 16px 0">
                                <span
                                    style="
                                        font-family:
                                            -apple-system, BlinkMacSystemFont,
                                            &quot;Segoe UI&quot;, Roboto,
                                            Helvetica, Arial, sans-serif;
                                        font-size: 13px;
                                        color: #8893b5;
                                    "
                                >
                                    Address: <%= address %>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding: 14px 16px 0">
                                <span
                                    style="
                                        font-family:
                                            -apple-system, BlinkMacSystemFont,
                                            &quot;Segoe UI&quot;, Roboto,
                                            Helvetica, Arial, sans-serif;
                                        font-size: 12px;
                                        color: #b0b6c9;
                                    "
                                >
                                    &copy; <%= new Date().getFullYear() %> <%=
                                    brand %>. This is an automated message,
                                    please don't reply.
                                </span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
